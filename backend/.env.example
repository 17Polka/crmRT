# .env.example — скопируй в .env и заполни реальными значениями

# ─── База данных ──────────────────────────────────────────────────────────
# asyncpg драйвер (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://crm:secret@localhost:5432/crmrt

# ─── JWT (dev-режим без Keycloak) ─────────────────────────────────────────
SECRET_KEY=CHANGE_ME_in_production_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ─── Keycloak (prod) ──────────────────────────────────────────────────────
KEYCLOAK_ENABLED=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=crmrt
KEYCLOAK_CLIENT_ID=crm-backend

# ─── CORS ─────────────────────────────────────────────────────────────────
# Через запятую: workflow-сервис (3000), Vite dev (5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
